      ],
      "dialog": [
        { "t": 1.0, "who": "amara", "dur": 6.5,
          "text": "Reaksi alerginya cukup kuat — tubuhnya menyerang sesuatu yang sebenarnya tidak berbahaya." },
        { "t": 8.5, "who": "ria", "dur": 7.0,
          "text": "Aneh... sebagian pasukan kita ngamuk sendiri. Musuh dalam selimut! Tenangkan medan, jangan sampai tubuh melukai dirinya sendiri." }
      ]
    },
