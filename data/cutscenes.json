          "actors": [ { "who": "mako", "x": 0.62, "y": 0.55, "s": 0.4 } ],
          "props": [ { "type": "toxicDrift" } ] }
      ],
      "dialog": [
        { "t": 1.0, "who": "amara", "dur": 6.5,
          "text": "Sepertinya ada yang tidak beres dengan makanannya semalam. Kita bantu tubuhnya membersihkan diri." },
        { "t": 8.5, "who": "ria", "dur": 7.0,
          "text": "Racun ikut masuk bareng makanan! Musuh datang lebih cepat dan acak — hajar di Lambung sebelum menyebar!" }
      ]
    },
    "transisi_bab_alergi": {
      "seenKey": "cutscene_transisi_bab_alergi",
