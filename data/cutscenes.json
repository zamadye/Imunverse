  "nft": {
    "move": { "vo": "assets/audio/narration/ria_nft_move.mp3",
      "text": "Nah, gitu dong! Lo sel makrofag — si nelam musuh. Geser ke deket musuh, gih!" },
    "levelup": { "vo": "assets/audio/narration/ria_nft_levelup.mp3",
      "text": "Level up! Lo makin gede, makin kerasa nampolnya. Gas lagi, jangan rem!" },
    "skill": { "vo": "assets/audio/narration/ria_nft_skill.mp3",
      "text": "Nah, itu skill lo! Efeknya gede, tapi ada jeda sebelum bisa dipakai lagi. Pilih waktu yang jitu, ya." },
    "revive": { "vo": "assets/audio/narration/ria_nft_revive.mp3",
      "text": "Duh, rebahan! Tapi masih ada sel penjaga yang nge-charge lo. Berdiri lagi — kali ini lebih waspada, gih?" }
