      ],
      "dialog": [
        { "t": 1.0, "who": "amara", "dur": 11.6,
          "vo": "assets/audio/narration/amara_transisi_ch2.mp3",
          "text": "Suhunya naik jadi 38.5, tapi ini normal kok — badan lagi kerja ekstra ngelawan virus flu-nya." },
        { "t": 10.5, "who": "ria", "dur": 19.0,
          "vo": "assets/audio/narration/ria_transisi_ch2.mp3",
          "text": "Denger itu? Suhu naik artinya sinyal bahaya baru aja dikirim ke seluruh badan. Bentar lagi bala bantuan bakal lebih banyak yang dateng — tapi musuhnya juga makin ganas. Siap-siap." }
      ]
    },
    "transisi_bab_racun": {
