      ],
      "dialog": [
        { "t": 1.0, "who": "amara", "dur": 6.5,
          "text": "Malam ini penentuan. Aku di sini — dan 'pasukan' di dalam sana juga tidak akan menyerah." },
        { "t": 8.5, "who": "ria", "dur": 7.0,
          "text": "Semua ancaman yang pernah kita lawan, datang bersamaan. Satu malam. Satu tubuh. Satu kesempatan. Untuk Inang!" }
      ]
    },
