            }
          ]
        },
        {
          "dur": 3000,
          "bg": [
            "#fff3e0",
            "#ffd9b0"
          ],
          "text": "Di dunia atas: Dr. Amara tersenyum lega kepada dua orang tua muda. Inang kita... anak mereka.",
          "actors": [
            {
              "sprite": "assets/sprites/amara_pose_talk.png",
