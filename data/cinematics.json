          ]
        },
        {
          "dur": 3000,
          "bg": [
            "#fff3e0",
            "#ffd9b0"
          ],
          "text": "Di dunia atas: sebuah boneka usang dipeluk erat di ranjang periksa. Tunggu... boneka?",
          "actors": [
            {
              "sprite": "assets/sprites/amara_pose_talk.png",
              "from": [
                0.09999999999999998,
                0.52
              ],
              "to": [
