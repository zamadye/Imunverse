      "shots": [
        {
          "dur": 3000,
          "bg": [
            "#e7f6ee",
            "#bfe8d2"
          ],
          "text": "RIA: \"Medan tenang. Pasukan kembali waras — kamu menyelamatkan tubuh dari dirinya sendiri.\"",
          "actors": [
            {
              "sprite": "assets/sprites/ria_pose_talk.png",
              "from": [
                0.65,
                0.75
              ],
              "to": [
                0.65,
