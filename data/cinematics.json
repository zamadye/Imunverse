    {
      "id": "clear_bab_final",
      "shots": [
        {
          "dur": 3400,
          "bg": [
            "#fff8e1",
            "#ffe1b3"
          ],
          "text": "Kamar rumah sakit. Cahaya pagi masuk lewat jendela.",
          "actors": [
            {
              "sprite": "assets/sprites/amara_pose_talk.png",
              "from": [
                0.09999999999999998,
                0.52
              ],
              "to": [
                0.3,
                0.52
              ],
              "scale": 0.34
            }
          ]
        },
        {
          "dur": 3400,
          "bg": [
            "#fff8e1",
            "#ffe1b3"
          ],
          "text": "Dr. Amara: \"Selamat, dia bertahan dengan baik. Sekarang tinggal istirahat — biar 'pasukan' di dalam yang lanjutkan kerjanya.\"",
          "actors": [
            {
              "sprite": "assets/sprites/amara_pose_talk.png",
              "from": [
                0.09999999999999998,
                0.52
              ],
              "to": [
                0.3,
                0.52
              ],
              "scale": 0.42
            }
          ]
        },
        {
          "dur": 3600,
          "bg": [
            "#ffe9f0",
            "#ffd0e0"
          ],
          "text": "Seorang anak kecil membuka matanya — Inang yang kamu jaga selama ini — dan tertawa.",
          "ease": "inOut"
        },
        {
          "dur": 3600,
          "bg": [
            "#e7f6ee",
            "#bfe8d2"
          ],
          "text": "RIA: \"Kerja bagus. Lo nggak akan pernah ketemu dia langsung, tapi... dia baru aja dapet satu hari lagi buat hidup — gara-gara lo.\"",
          "actors": [
            {
              "sprite": "assets/sprites/ria_pose_talk.png",
