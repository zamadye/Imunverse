            }
          ]
        },
        {
          "dur": 3000,
          "bg": [
            "#fff3e0",
            "#ffd9b0"
          ],
          "text": "Di dunia atas: seseorang berjanji tidak jajan sembarangan lagi.",
          "actors": [
            {
              "sprite": "assets/sprites/amara_pose_talk.png",
              "from": [
                0.09999999999999998,
                0.52
              ],
              "to": [
                0.3,
