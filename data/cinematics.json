      "shots": [
        {
          "dur": 3000,
          "bg": [
            "#e7f6ee",
            "#bfe8d2"
          ],
          "text": "RIA: \"Racun bersih! Perutnya tenang lagi.\"",
          "actors": [
            {
              "sprite": "assets/sprites/ria_pose_talk.png",
              "from": [
                0.65,
                0.75
              ],
              "to": [
                0.65,
