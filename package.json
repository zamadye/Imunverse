{
  "name": "imunverse",
  "version": "1.0.0",
  "description": "Imunverse — HTML5 roguelike survival bertema sel imun. Vanilla JS + Canvas 2D, tanpa framework.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 0.0.0.0",
    "sprites": "python3 tools/gen_sprites.py",
    "check": "node scripts/check-imports.mjs",
    "ecosystem-assets": "python3 tools/gen_ecosystem_assets.py",
    "check:ecosystem-assets": "node scripts/verify-ecosystem-assets.mjs",
    "validate:catalog": "node tools/validate-catalog.mjs",
    "validate:retention": "node tools/validate-retention.mjs",
    "validate": "npm run validate:catalog && npm run validate:retention"
  }
}
