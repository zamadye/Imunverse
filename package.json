{
  "name": "phagos",
  "version": "1.0.0",
  "description": "PHAGOS — HTML5 roguelike survival bertema sel imun. Vanilla JS + Canvas 2D, tanpa framework.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 0.0.0.0",
    "sprites": "python3 tools/gen_sprites.py",
    "check": "node scripts/check-imports.mjs",
    "validate": "node tools/validate-catalog.mjs && node tools/validate-retention.mjs",
    "ecosystem-assets": "python3 tools/gen_ecosystem_assets.py",
    "check:ecosystem-assets": "node scripts/verify-ecosystem-assets.mjs",
    "verify:photos": "node tools/verify-mutation-photos.mjs"
  }
}
